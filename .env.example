# Vorlage – echte Werte nur in .env.local (lokal) bzw. in den Vercel Environment Variables eintragen.
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=465
SMTP_USER=
# App-Passwort, nur für SMTP. Niemals committen.
SMTP_PASS=
# Feste Empfängeradresse für Formularanfragen
SMTP_TO=
# Absender – muss für SMTP_USER bei mailbox.org als Alias freigegeben sein
SMTP_FROM=

# Optional: Cloudflare Turnstile (Captcha). Leer lassen = deaktiviert.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
